#!/usr/bin/env sh
set -eu

DOCKER_USER="${SBX_DOCKER_USER:?set SBX_DOCKER_USER to the provisioned guest user}"
id "$DOCKER_USER" >/dev/null 2>&1 || {
  echo "rootless Docker user does not exist: $DOCKER_USER" >&2
  exit 1
}
DOCKER_UID="$(id -u "$DOCKER_USER")"
RUNTIME_DIR="/run/user/$DOCKER_UID"
SOCK="unix://$RUNTIME_DIR/docker.sock"
DOCKER_PATH="/usr/sbin:/sbin:$PATH"
LOG_PATH="${1:-/var/log/dockerd-rootless.log}"
RESOLV_CONF="${SBX_DOCKER_RESOLV_CONF:-/etc/resolv.conf}"

if [ "$(id -u)" != 0 ]; then
  exec sudo SBX_DOCKER_USER="$DOCKER_USER" "$0" "$@"
fi

as_user() {
  sudo -iu "$DOCKER_USER" env PATH="$DOCKER_PATH" XDG_RUNTIME_DIR="$RUNTIME_DIR" DOCKER_HOST="$SOCK" "$@"
}

docker_ready() {
  as_user docker version >/dev/null 2>&1
}

daemon_running() {
  pgrep -u "$DOCKER_UID" -x dockerd >/dev/null 2>&1 \
    || pgrep -u "$DOCKER_UID" -f '/dockerd-rootless\.sh([[:space:]]|$)' >/dev/null 2>&1
}

wait_for_docker() {
  message="$1"
  i=0
  while ! docker_ready; do
    i=$((i + 1))
    if [ "$i" -ge 30 ]; then
      echo "$message; log: $LOG_PATH" >&2
      tail -80 "$LOG_PATH" >&2 2>/dev/null || true
      return 1
    fi
    sleep 1
  done
}

if docker_ready; then
  exit 0
fi

if daemon_running; then
  wait_for_docker "rootless Docker is running but unresponsive"
  exit 0
fi

touch /etc/subuid /etc/subgid
awk -F: -v user="$DOCKER_USER" '$1 == user { found=1 } END { exit !found }' /etc/subuid \
  || printf '%s:100000:65536\n' "$DOCKER_USER" >> /etc/subuid
awk -F: -v user="$DOCKER_USER" '$1 == user { found=1 } END { exit !found }' /etc/subgid \
  || printf '%s:100000:65536\n' "$DOCKER_USER" >> /etc/subgid

printf 'nameserver 10.0.2.3\nnameserver 8.8.8.8\nnameserver 8.8.4.4\n' > "$RESOLV_CONF"
mkdir -p /sys/fs/cgroup /dev/net "$RUNTIME_DIR"
mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null || true
mknod /dev/net/tun c 10 200 2>/dev/null || true
chmod 666 /dev/net/tun 2>/dev/null || true
chown "$DOCKER_USER:$(id -gn "$DOCKER_USER")" "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"

touch "$LOG_PATH"
chown "$DOCKER_USER:$(id -gn "$DOCKER_USER")" "$LOG_PATH"
as_user start-stop-daemon --start --background \
  --exec /usr/bin/dockerd-rootless.sh \
  --startas /usr/bin/dockerd-rootless.sh \
  --output "$LOG_PATH"

wait_for_docker "rootless Docker did not start"
