ARG BASE_IMAGE=debian:stable-slim
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl iproute2 isc-dhcp-client openssh-server python3 python3-h2 \
    && rm -rf /var/lib/apt/lists/*
RUN dpkg-query -W -f='${binary:Package}\t${Version}\t${Architecture}\n' > /usr/share/sbx-test-dependencies.tsv
COPY network.sh /etc/smolvm/network.sh
RUN chmod 0755 /etc/smolvm/network.sh
